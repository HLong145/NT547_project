# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Bí mật — KHÔNG BAO GIỜ commit
.env
*.pem
*service-account*.json
gcp-*.json

# Dữ liệu tác giả (444 MB) — tải bằng: python -m address_misuse.fetch_author_data
data/Address-Misuse/

# Dữ liệu lớn / tái tạo được
data/raw/
# seed: tạo bằng `python -m address_misuse.seed` (MANIFEST.json vẫn được commit)
data/seed/*.parquet
# interim: commit kết quả (nhỏ, đã quét không có chuỗi giống private key); bỏ log và ma trận .npy (tái tạo được)
data/interim/*
!data/interim/*.parquet
!data/interim/*.json
!data/interim/*.jsonl
!data/interim/*.csv

# Paper gốc (bản quyền USENIX/tác giả) — tải tại link trong README
docs/*.pdf

# Editor / OS / Claude Code cục bộ
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
CLAUDE.md
CLAUDE.local.md

# Đáp án pilot (tầng lấy mẫu + nhãn tác giả) — người gán không được xem
data/gold/*_key.csv
