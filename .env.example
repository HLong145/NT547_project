# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.

# Etherscan API V2 (một key dùng cho mọi chain được gói của bạn hỗ trợ)
ETHERSCAN_API_KEY=
# 1000 nếu dùng gói miễn phí, 10000 nếu gói trả phí
ETHERSCAN_PAGE_SIZE=1000

# Google BigQuery (dữ liệu Ethereum số lượng lớn)
GCP_PROJECT_ID=
# Để trống nếu đăng nhập bằng `gcloud auth application-default login` (khuyến nghị)
GOOGLE_APPLICATION_CREDENTIALS=

# RPC (để trống sẽ dùng RPC công khai mặc định trong config.py)
RPC_ETH=
RPC_BSC=
RPC_ARB=
RPC_OP=
RPC_BASE=
RPC_POLYGON=
RPC_SEPOLIA=
RPC_BSC_TESTNET=
