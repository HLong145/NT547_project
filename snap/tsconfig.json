{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@metamask/snaps-sdk",
    "types": [
      "jest",
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "src",
    "snap.config.ts"
  ]
}
